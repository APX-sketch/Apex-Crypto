# ===== إعدادات البريد — Apex Crypto =====
# انسخ هذا الملف إلى اسم .env ثم املأ القيم.
#   cp .env.example .env
# لتفعيل البريد الحقيقي لازم تثبّت حزمة nodemailer:
#   npm i nodemailer

# ===================================================================
# الطريقة (أ) — Gmail (الأسهل): اضبط هذين المتغيرين فقط
# ===================================================================
# بريدك على Gmail
EMAIL_USER=your_email@gmail.com
# App Password من Google (16 حرفاً — وليس كلمة مرور الحساب)
# أنشئها من: Google Account -> Security -> App passwords (بعد تفعيل التحقق بخطوتين)
EMAIL_PASS=your_16_char_app_password

# ===================================================================
# الطريقة (ب) — أي مزوّد SMTP آخر (بدل طريقة أ)
# ===================================================================
# SMTP_HOST=smtp.yourhost.com
# SMTP_PORT=465
# true للمنفذ 465 (SSL)، و false للمنفذ 587 (STARTTLS)
# SMTP_SECURE=true
# SMTP_USER=your_email@domain.com
# SMTP_PASS=your_password
# MAIL_FROM=Apex Crypto <your_email@domain.com>

# ===== خيارات OTP والأمان =====
# تفعيل تأكيد الدخول برمز OTP (true = مفعّل، وهو الافتراضي)
LOGIN_OTP=true
# true يُظهِر الرمز داخل الواجهة للاختبار — اجعله false في الإنتاج حتى يصل الرمز للإيميل فقط
OTP_DEBUG=false
# مدة صلاحية «تذكّر الجهاز» بالملي ثانية (الافتراضي 30 يوماً)
TRUST_DEVICE_TTL_MS=2592000000
